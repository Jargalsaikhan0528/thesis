# Copy this file to .env (in the project root) and fill in your own values.
# NEVER commit the .env file itself — it is excluded via .gitignore.

# OpenAI API key for GPT-4o scoring (notebook 05c)
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Optional: SEC EDGAR requires a User-Agent header identifying the requester.
# Use the format: "Your Name your.email@example.com"
SEC_USER_AGENT=Your Name your.email@example.com
